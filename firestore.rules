rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones de soporte y validación ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             (request.auth.token.email == 'bernatcosta@iesamachado.org' || 
              request.auth.token.email.lower() == 'bernatcosta@iesamachado.org');
    }

    function isAdmin() {
      return isSuperAdmin() || 
             (isAuthenticated() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isTeacher() {
      return isAdmin() || 
             (isAuthenticated() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
    }

    // ── Colección de Usuarios y sus subcolecciones ──
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // Subcolecciones del usuario (ej: /users/{userId}/games/{gameId})
      match /{allChildren=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ── Colección de Docentes Autorizados ──
    match /allowed_teachers/{teacherEmail} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Colección de Alumnos Autorizados ──
    match /allowed_students/{studentEmail} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ── Colección de Clases ──
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && 
        (resource.data.teacherId == request.auth.uid || isAdmin());

      // Subcolección de miembros de clase
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher() || (isAuthenticated() && request.auth.uid == memberId);
      }

      // Subcolección de tareas
      match /assignments/{assignmentId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher();
      }
    }

    // ── Membresías de clases por PIN ──
    match /class_members/{memberDocId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Colección de Resultados de Juegos ──
    match /game_results/{resultId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || isTeacher());
      allow update, delete: if isAdmin();
    }

    // ── Sesiones en vivo (MecanoClass & RompeCódigos) ──
    match /live_sessions/{sessionId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /live_participants/{participantId} {
      allow read, write: if isAuthenticated();
    }

    // ── Textos de MecanoClass ──
    match /mecanoclass_texts/{textId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ── Bots públicos de ArenaBots ──
    match /public_bots/{botId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ── Banco de Preguntas Test ──
    match /preguntas/{preguntaId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ── Exámenes Test ──
    match /examenes_test/{examenId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ── Respuestas de Exámenes ──
    match /test_teoria_respuestas/{docId} {
      allow read: if isTeacher() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }

    match /respuestas_test/{respuestaId} {
      allow read: if isTeacher() || 
        (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.uid == request.auth.uid;
      allow update: if isTeacher() || 
        (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isTeacher();
    }

    // ── Configuración global del sitio ──
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /site_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
