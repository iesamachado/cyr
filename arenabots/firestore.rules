rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección principal de usuarios (solo su propio perfil)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Nueva colección global de robots para Matchmaking
    match /public_bots/{botId} {
      // Cualquiera autenticado puede leer todos los bots para buscar oponente
      allow read: if request.auth != null;
      
      // Crear: Debes estar autenticado y el ownerId debe ser tu propio UID
      allow create: if request.auth != null 
                    && request.resource.data.ownerId == request.auth.uid;
      
      // Actualizar:
      // O eres el dueño (puedes cambiar nombre, código, avatar...)
      // O solo estás actualizando stats ('wins', 'matches', 'winRate') después de un combate
      allow update: if request.auth != null && (
                      resource.data.ownerId == request.auth.uid 
                      || 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wins', 'matches', 'winRate'])
                    );
      
      // Borrar: Solo el dueño puede borrarlo
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    
    // Clases
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Torneos
    match /tournaments/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
      allow update: if request.auth != null && (
                      resource.data.teacherId == request.auth.uid 
                      || 
                      (request.resource.data.teacherId == resource.data.teacherId)
                    );
    }
    
  }
}
